{{!--
  Character Class
  ---
  A widget that renders a character class, its level, and current/next level XP.
--}}
{{#*inline "character-class"}}
  <article aria-label="Level {{system.level}} {{name}}">
    <img
      src="{{img}}"
      class="document-art"
      alt=""
    />
    <div class="character-class__name">
        Lv. {{system.level}} {{name}}
    </div>
    <uft-character-info-meter
      value="{{xpBar.current}}"
      min="{{xpBar.min}}"
      max="{{xpBar.max}}"
      class="xp"
    >
    </uft-character-info-meter>
  </article>
{{/inline}}

{{!-- ===================================================================== --}}

{{!--

--}}
{{#*inline "character-identity"}}
    <div class="left-rail__section left-rail__section--portrait">
      <img src="{{document.img}}" alt="" />
      <h2 class="decorated">{{document.name}}</h3>
    </div>
  <div class="left-rail__section">
    <dl>
      <dt>{{localize "BAGS.Actors.Character.Identity.Alignment"}}</dt>
      <dd>{{ifThen document.system.biographicalDetails.alignment
            document.system.biographicalDetails.alignment
            (localize "BAGS.Actors.Character.Identity.Unaligned")
          }}
      </dd>
    </dl>
  </div>
  {{#if (eq document.type "character")}}
    <div class="left-rail__section left-rail__section--character-classes">
      <h3 class="decorated">
        {{localize
          (ifThen (gt classes.length 1)
            "BAGS.Actors.Character.Identity.Classes"
            "BAGS.Actors.Character.Identity.Class"
          )
        }}</h3>
      <ul class="character-classes">
        {{#each classes}}
          <li class="character-class">{{> character-class this}}</li>
        {{else}}
          <p class="empty">{{localize "BAGS.Actors.Character.NoClasses"}}</p>
        {{/each}}
      </ul>
    </div>
  {{/if}}

{{/inline}}

{{!-- ===================================================================== --}}

{{!--

--}}
{{#*inline "tab-navigation"}}
  <nav class="tabs tabs--left-rail">
    {{#each tabs}}
      <button class="{{ifThen active "active" ""}}" data-tooltip="{{localize label}}" data-action="tab" data-group="{{group}}" data-tab="{{id}}" aria-label="{{localize label}}"><i class="{{icon}}"></i></button>
    {{/each}}
  </nav>
{{/inline}}

{{!-- ===================================================================== --}}

{{!--

--}}
{{#*inline "ability-scores"}}
  <div class="left-rail__section number-showcase">
    <ul class="number-showcase__list">
      {{#each document.system.schema.fields.base.fields.abilityScores}}
      <li data-action="roll-ability-score" data-ability-score="{{name}}" data-tooltip="{{lookup ../abilityScoreTooltips name}}" class="{{#if (lookup ../abilityScoreModifications name)}}field--{{lookup ../abilityScoreModifications name}}{{/if}}">
        <span class="number-showcase__label">{{localize (replace label "Label" "Short") }}</span>
        <span class="number-showcase__value">{{lookup ../document.system.base.abilityScores name}}</span>
      </li>
       {{/each}}
    </ul>
  </div>
{{/inline}}

{{!-- ===================================================================== --}}

{{!--

--}}
{{#*inline "combat-modifiers"}}
  <div class="left-rail__section">
    <dl>
      {{#if (eq document.type "monster")}}
        {{#with document.system.hp.hitDice}}
          {{#if usesHitDice}}
            <dt>Hit Dice</dt>
            <dd class="rollable rollable--icon-before" data-action="roll-hp">{{count}}d{{size}}{{ifThen modifier (signNumber modifier) ""}}</dd>
          {{/if}}
        {{/with}}
      {{/if}}
      {{#if usesDescendingAC}}
      <dt data-tooltip="{{combatTooltips.thac0}}" class="{{#if combatModifications.thac0}}field--{{combatModifications.thac0}}{{/if}}">THAC0</dt>
      <dd class="{{#if combatModifications.thac0}}field--{{combatModifications.thac0}}{{/if}}">{{document.system.thac0}}</dd>
      {{else}}
      <dt data-tooltip="{{combatTooltips.baseAttackBonus}}" class="{{#if combatModifications.baseAttackBonus}}field--{{combatModifications.baseAttackBonus}}{{/if}}">Attack Bonus</dt>
      <dd class="{{#if combatModifications.baseAttackBonus}}field--{{combatModifications.baseAttackBonus}}{{/if}}">{{signNumber document.system.baseAttackBonus forceSign=true}}</dd>
      {{/if}}

      <dt data-tooltip="{{combatTooltips.ac}}" class="{{#if combatModifications.ac}}field--{{combatModifications.ac}}{{/if}}">Armor Class</dt>
      <dd class="{{#if combatModifications.ac}}field--{{combatModifications.ac}}{{/if}}">{{document.system.armorClass}}</dd>

      <dt data-tooltip="{{combatTooltips.movement}}" class="movement">Movement</dt>
      {{#if (eq document.type "character")}}
        <dd>
          {{#with document.system.speed}}
            {{exploration}}/{{encounter}}/{{overland}}
          {{/with}}
        </dd>
      {{else}}
        <dd>
          {{#with document.system.speed}}
            {{exploration}} ({{encounter}})
          {{/with}}
        </dd>
      {{/if}}
    </dl>
  </div>

  {{#if (eq document.type "character")}}
  <div class="left-rail__section left-rail__section--combat">
    <header>
      <h3>{{localize "BAGS.Actors.Common.Combat.Modifiers"}}</h3>
      <span>{{localize "BAGS.Actors.Common.Combat.Attack"}}</span>
      <span>{{localize "BAGS.Actors.Common.Combat.Damage"}}</span>
    </header>

    <dl>
      <dt data-tooltip="{{combatTooltips.meleeAttack}}" class="rollable rollable--icon-before {{#if combatModifications.meleeAttack}}field--{{combatModifications.meleeAttack}}{{/if}}" data-action="roll-attack" data-attack-type="melee">{{localize "BAGS.Actors.Common.Combat.Melee"}}</dt>
      <dd class="{{#if combatModifications.meleeAttack}}field--{{combatModifications.meleeAttack}}{{/if}}">{{signNumber document.system.meleeAttackBonus forceSign=true}}</dd>
      <dd data-tooltip="{{combatTooltips.meleeDamage}}" class="{{#if combatModifications.meleeDamage}}field--{{combatModifications.meleeDamage}}{{/if}}">{{signNumber document.system.meleeDamageBonus forceSign=true}}</dd>
      <dt data-tooltip="{{combatTooltips.missileAttack}}" class="rollable rollable--icon-before {{#if combatModifications.missileAttack}}field--{{combatModifications.missileAttack}}{{/if}}" data-action="roll-attack" data-attack-type="missile">{{localize "BAGS.Actors.Common.Combat.Missile"}}</dt>
      <dd class="{{#if combatModifications.missileAttack}}field--{{combatModifications.missileAttack}}{{/if}}">{{signNumber document.system.missileAttackBonus forceSign=true}}</dd>
      <dd data-tooltip="{{combatTooltips.missileDamage}}" class="{{#if combatModifications.missileDamage}}field--{{combatModifications.missileDamage}}{{/if}}">{{signNumber document.system.missileDamageBonus forceSign=true}}</dd>
    </dl>
  </div>
  {{/if}}
{{/inline}}

{{!-- ===================================================================== --}}

{{!--

--}}
{{#*inline "saving-throws"}}
  <div class="left-rail__section left-rail__section--saving-throws">
    <h3 class="decorated">Saving Throws</h3>
    <dl>
      {{#each savingThrowLocaleStrings as |save key|}}
        <dt data-tooltip="{{lookup ../savingThrowTooltips key}}" class="rollable rollable--icon-before {{#if (lookup ../savingThrowModifications key)}}field--{{lookup ../savingThrowModifications key}}{{/if}}" data-action="roll-saving-throw" data-saving-throw="{{key}}">{{localize save.short}}</dt>
        <dd class="{{#if (lookup ../savingThrowModifications key)}}field--{{lookup ../savingThrowModifications key}}{{/if}}">{{lookup ../document.system.savingThrows key}}</dd>
      {{/each}}
      {{#if (eq document.type "character")}}
        <dt>Bonus vs. Magic</dt>
        <dd>
          {{signNumber document.system.abilityScores.wis.magicSave forceSign=true}}
        </dd>
      {{/if}}

      {{#if (and (eq document.type "monster") document.system.magicResistance) }}
        <dt>Magic Resistance</dt>
        <dd>75%</dd>
      {{/if}}
    </dl>
  </div>
{{/inline}}

{{!-- ===================================================================== --}}

{{!--

--}}
{{#*inline "monster-details"}}
  <div class="left-rail__section left-rail__section--monster-details">
    <h3 class="decorated">Monster Details</h3>
    <dl>
      <dt>{{localize "BAGS.Actors.Monster.Details.Alignment.Label"}}</dt>
      <dd>{{ifThen document.system.biographicalDetails.alignment document.system.biographicalDetails.alignment (localize "BAGS.Actors.Monster.Details.Alignment.Unaligned")}}</dd>

      {{#if document.system.biographicalDetails.intelligence}}
      <dt>{{localize "BAGS.Actors.Monster.Details.Intelligence"}}</dt>
      <dd>{{document.system.biographicalDetails.intelligence}}</dd>
      {{/if}}

      {{!--
        Number Appearing and Treasure Table are not in the monster schema yet,
        so their rows are omitted rather than rendering placeholder text. Morale
        is displayed but not rollable -- there is no roll-morale handler.
      --}}
      <dt>{{localize "BAGS.Actors.Monster.Details.MoraleRating"}}</dt>
      <dd>{{document.system.morale.value}}</dd>
    </dl>
  </div>
{{/inline}}


{{!-- ===================================================================== --}}

{{!--

--}}
{{#*inline "employment-details"}}
  <dl>
    <dt>Employed by</dt>
    <dd>{{document.system.retainer.employer}}</dd>

    {{#if document.system.retainer.wage.quantity}}
      <dt>Wage</dt>
      <dd>{{document.system.retainer.wage.quantity}}/month</dd>
    {{/if}}
  </dl>
{{/inline}}

{{!-- ===================================================================== --}}

{{!--
  One row per thing you can do with the gear you're using.

  Deliberately flat, with the source named on the row rather than in a header
  above a group of rows. A weapon always has at least its attack, so grouping
  spent two lines saying "Longsword" and then "Attack" -- while a shield with one
  action and a halberd with three had to be laid out differently from each other
  for no reason the reader cares about. Naming the source on the row costs a line
  per action rather than a line per item, which is a little more vertical space
  for the rare item with several actions and less for everything else.
--}}
{{#*inline "gear-action"}}
  {{!--
    A spent action stays clickable on purpose. Greying it says "not right now";
    clicking it is how you find out why, because the resolver names the action
    and its charge count when it refuses.
  --}}
  <button class="action-list-item"
    role="listitem"
    data-action="use-action"
    data-item-id="{{itemId}}"
    data-action-id="{{action.id}}"
    {{#if exhausted}}data-exhausted aria-disabled="true"{{/if}}>
    <img class="action-list-item__icon" src="{{action.img}}" alt="" role="presentation" />
    <span class="action-list-item__identity">
      <span class="action-list-item__title">{{action.name}}</span>
      <span class="action-list-item__parent">
        <img class="action-list-item__parent-icon" src="{{source.img}}" alt="" role="presentation" />
        {{source.name}}
      </span>
    </span>
    {{#if action.uses.max}}
      <span class="action-list-item__uses">{{action.uses.value}}/{{action.uses.max}}</span>
    {{/if}}
  </button>
{{/inline}}

{{!-- ===================================================================== --}}

{{!--

--}}
{{#*inline "effect-list-item"}}
  <button class="action-list-item action-list-item--single-action"
    role="listitem"
    data-action="view-effect"
    data-parent-type="{{parent.type}}"
    data-parent-id="{{parent.id}}"
    data-effect-id="{{id}}">
    <img class="action-list-item__icon" src="{{img}}" alt="" role="presentation" />
    <span class="action-list-item__identity">
      <span class="action-list-item__title">{{name}}</span>
    </span>
  </button>
{{/inline}}


{{!-- ===================================================================== --}}

<section class="left-rail theme-dark">
  <article class="meters">
    <uft-character-info-meter
      value="{{document.system.hp.value}}"
      max="{{document.system.hp.max}}"
      name="system.hp.value"
      editable
      class="hp"
    >
      <i
        slot="icon"
        class="fa fa-heart"
      ></i>
    </uft-character-info-meter>

    {{{ encumbranceMeter }}}
  </article>

  {{> tab-navigation}}

  {{#> sheetTab tab=tabs.summary}}
    {{#if (eq document.type "character")}}
      {{> ability-scores}}
    {{/if}}

    {{> combat-modifiers }}

    {{#if (eq document.type "monster")}}
      {{> monster-details}}
    {{/if}}

    {{> saving-throws}}

    {{#if document.system.retainer.isRetainer}}
      {{> employment-details}}
    {{/if}}
  {{/sheetTab}}

  {{#> sheetTab tab=tabs.identity}}
    {{> character-identity}}
  {{/sheetTab}}

  {{#> sheetTab tab=tabs.actions}}
    {{#if (eq document.type "character")}}
      <div class="left-rail__section">
        <h3 class="decorated">{{localize "BAGS.Actors.Character.ExplorationSkills"}}</h3>
        <div class="action-grid action-grid--exploration-skills">
          {{#each document.system.actions}}
          <button
            class="action-grid-item"
            data-tooltip="{{name}}"
            data-action="use-action"
            data-action-id="{{id}}"
          >
            <img
              src="{{img}}"
              alt="{{localize name}}"
            />
          </button>
          {{/each}}
        </div>
      </div>
    {{/if}}

    {{!--
      What the actor is holding. Weapons first, since that's what you reach for
      when a fight starts, then armor, then everything else.
    --}}
    <div class="left-rail__section">
      <div class="action-list" role="list">
        <div class="action-category">
          <h3 class="action-category__header decorated">{{localize "BAGS.Actors.Character.Equipment.Title"}}</h3>
          {{#each document.usableActions.gear}}
            {{> gear-action}}
          {{else}}
            <p class="empty">{{localize "BAGS.Actors.Character.Equipment.NoGearActions"}}</p>
          {{/each}}
        </div>
      </div>
    </div>

    {{!--
      What the actor can do regardless of what they're holding: class abilities,
      whatever their ancestry grants, and any loose abilities they've picked up.
      A grid rather than a list, because these are icons you learn the shape of
      and reach for -- the tooltip carries the detail when you need it.

      Passive traits are not here on purpose. Anything that just *is* true about
      a character belongs in Active Effects, and this section is only the things
      you choose to do.
    --}}
    {{#if document.usableActions.abilities.length}}
      <div class="left-rail__section">
        <h3 class="decorated">{{localize "BAGS.Actors.Common.Actions.ActiveAbilities"}}</h3>
        <div class="action-grid action-grid--abilities">
          {{#each document.usableActions.abilities}}
            <bags-action-tile
              uuid="{{source.uuid}}"
              action-id="{{action.id}}"
              data-action="use-action"
              data-item-id="{{itemId}}"
              data-action-id="{{action.id}}"
              {{#if exhausted}}exhausted{{/if}}
            ></bags-action-tile>
          {{/each}}
        </div>
      </div>
    {{/if}}
  {{/sheetTab}}

  {{#> sheetTab tab=tabs.effects}}
    <div class="left-rail__section">
      <div class="action-category">
        <h3 class="decorated">{{localize "BAGS.Actors.Common.Effects.Temporary"}}</h3>
        {{#if document.temporaryAppliedEffects.length}}
          <div class="action-list action-list--effects" role="list">
            {{#each document.temporaryAppliedEffects}}
              {{> effect-list-item}}
            {{/each}}
          </div>
        {{else}}
          <p class="empty">You have no temporary effects.</p>
        {{/if}}
      </div>

      <div class="action-category">
        <h3 class="decorated">{{localize "BAGS.Actors.Common.Effects.Lingering"}}</h3>
        {{#if document.lastingAppliedEffects.length}}
          <div class="action-list action-list--effects" role="list">
            {{#each document.lastingAppliedEffects}}
              {{> effect-list-item}}
            {{/each}}
          </div>
        {{else}}
          <p class="empty">You have no lingering effects.</p>
        {{/if}}
      </div>
    </div>
  {{/sheetTab}}
</section>

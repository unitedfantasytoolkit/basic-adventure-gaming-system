{{!--
  The roster. Rows follow the combat tracker's shape: portrait, name and controls,
  then the numbers. Both the list and the empty state are drop targets.
--}}
{{#if members.length}}
  <ol class="party-list plain">
    {{#each members}}
      <li
        class="party-member {{cssClass}}"
        data-actor-id="{{id}}"
        draggable="true"
      >
        <img class="member-image" src="{{img}}" alt="{{name}}" loading="lazy" />

        <div class="member-details">
          <div class="member-heading">
            <a class="name" data-action="openMember">{{name}}</a>

            <div class="member-controls">
              {{#if hasToken}}
                <button
                  type="button"
                  class="inline-control icon fa-solid fa-arrows-to-eye"
                  data-action="panToMember"
                  data-tooltip
                  aria-label="{{localize 'BAGS.Party.Members.PanTo'}}"
                ></button>
                <button
                  type="button"
                  class="inline-control icon fa-solid fa-bullseye"
                  data-action="pingMember"
                  data-tooltip
                  aria-label="{{localize 'BAGS.Party.Members.Ping'}}"
                ></button>
              {{/if}}
            </div>
          </div>

          <div class="member-stats">
            {{#if classLabel}}
              <span class="member-class">{{classLabel}}</span>
            {{/if}}

            {{!-- `data-stat` names each stat, so nothing depends on their order. --}}
            <span
              class="stat"
              data-stat="armorClass"
              data-tooltip
              aria-label="{{localize 'BAGS.Actors.Common.Stats.ArmorClass'}}"
            >
              <i class="fa-solid fa-shield-halved" inert></i>
              <span class="value">{{armorClass}}</span>
            </span>

            <span
              class="stat"
              data-stat="speed"
              data-tooltip
              aria-label="{{localize 'BAGS.Actors.Common.Stats.Movement'}}"
            >
              <i class="fa-solid fa-person-walking" inert></i>
              <span class="value">{{speed}}</span>
            </span>

            <span
              class="stat {{#if encumbrance.isFull}}full{{else if encumbrance.isSlowed}}slowed{{/if}}"
              data-stat="encumbrance"
              data-tooltip
              aria-label="{{localize 'BAGS.Party.Members.Load' value=encumbrance.value max=encumbrance.max}}"
            >
              <i class="fa-solid fa-weight-hanging" inert></i>
              <span class="value">{{encumbrance.value}}</span>
            </span>
          </div>

          <div
            class="member-hp"
            style="--hp-fraction: {{hp.fraction}}"
            data-hp-value="{{hp.value}}"
            data-hp-max="{{hp.max}}"
            data-tooltip
            aria-label="{{localize 'BAGS.Actors.Common.Stats.HP'}}"
          >
            <div class="hp-track"><div class="hp-fill"></div></div>
            <span class="hp-value">{{hp.value}}<span class="separator">&sol;</span>{{hp.max}}</span>
          </div>
        </div>
      </li>
    {{/each}}
  </ol>
{{else}}
  <div class="party-empty">
    <i class="fa-solid fa-users" inert></i>
    <p>{{localize "BAGS.Party.Empty"}}</p>
    {{#if isGM}}
      <p class="hint">{{localize "BAGS.Party.EmptyHint"}}</p>
    {{/if}}
  </div>
{{/if}}

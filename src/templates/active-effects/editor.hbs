<section class="active-effect-container">
  <header>
    <h2>{{localize "DOCUMENT.ActiveEffects"}}</h2>
    <button
      class="inline-control icon"
      data-action="add-active-effect"
      data-tooltip="BAGS.ActiveEffects.Add"
    ><i class="fa fa-plus" role="presentation"></i></button>
  </header>
  {{#if document.effects.size}}
    <ul class="effects scrollable">
      {{#each document.effects}}
        <li
          class="effects__card{{ifThen disabled ' effects__card--disabled' ''}}"
          data-effect-id="{{id}}"
          style="--effect-tint: {{tint}}"
        >
          <img class="effects__card__icon" src="{{img}}" role="presentation" />
          <div class="effects__card__summary">
            <span class="effects__card__name">{{name}}</span>
            {{!
              A duration is one amount and one unit from v14 on, so there's a
              single badge to show rather than one per unit.
            }}
            {{#if duration.value}}
              <div class="effects__card__duration">
                <span
                  class="effects__card__duration-unit effects__card__duration-unit--{{duration.units}}"
                ><i
                    class="fa
                      {{#if (eq duration.units 'rounds')}}
                        fa-dice-d20
                      {{else if (eq duration.units 'turns')}}
                        fa-user-clock
                      {{else}}fa-clock{{/if}}"
                    role="presentation"
                  ></i>{{duration.value}}
                  {{localize (concat "EFFECT.DURATION.UNITS." duration.units)}}</span>
              </div>
            {{/if}}

          </div>
          <menu class="effects__card__controls">
            <li>
              <button
                class="icon inline-control"
                data-action="toggle-active-effect"
                data-tooltip="BAGS.ActiveEffects.Toggle"
                aria-label="{{localize 'BAGS.ActiveEffects.Toggle'}}"
              >
                <i class="fa {{ifThen disabled 'fa-times' 'fa-check'}}"></i>
              </button>
            </li>
            <li>
              <button
                class="icon inline-control"
                data-action="edit-active-effect"
                data-tooltip="BAGS.ActiveEffects.Edit"
                aria-label="{{localize 'BAGS.ActiveEffects.Edit'}}"
              >
                <i class="fa fa-pencil"></i>
              </button>
            </li>
            <li>
              <button
                class="icon inline-control"
                data-action="delete-active-effect"
                data-tooltip="BAGS.ActiveEffects.Delete"
                aria-label="{{localize 'BAGS.ActiveEffects.Delete'}}"
              >
                <i class="fa fa-trash"></i>
              </button>
            </li>
          </menu>

          <ul class="effects__card__effect-list">
            {{#with (toArray statuses)}}
              {{#if this.length}}
                {{#each this}}
                  <li>
                    {{#with (statusEffect this)}}
                      <img src="{{img}}" role="presentation" />
                      {{localize name}}
                    {{/with}}
                  </li>
                {{/each}}
              {{/if}}
            {{/with}}

            {{#each changes}}
              <li>
                {{localize
                  (concat "BAGS.ActiveEffects.ModifierKeyLabels." key)
                  mod=(signNumber value)
                }}
              </li>
            {{/each}}
          </ul>

        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="empty">No Active Effects</p>
  {{/if}}
</section>